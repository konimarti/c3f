// Writes src/c3f/spacing_table.c3 from a corpus (the C3 standard library):
//   build/gen-spacing $(find <c3c>/lib/std -name '*.c3') > src/c3f/spacing_table.c3
module gen_spacing;
import c3f, c3::lexer, std::io, std::collections::map, std::collections::list, std::sort;

const uint MIN_COUNT = 5;

struct Count
{
	c3f::Rule rule;
	bool      kept;
}

fn void count(HashMap{ulong, Count}* table, c3f::GapKey* k, char level, bool space)
{
	c3f::Rule r = k.cell(level);
	ulong key = r.pack();
	Count* c = table.get_ref(key) ?? null;
	if (!c)
	{
		table.set(key, {.rule = r});
		c = table.get_ref(key)!!;
	}
	if (space)
	{
		c.rule.n1++;
	}
	else
	{
		c.rule.n0++;
	}
}

<* Both modes' answer, so two cells can be compared. *>
fn int decision(c3f::Rule* r) => r ? (int)r.decide(false) * 4 + (int)r.decide(true) : 0;

fn c3f::Rule* lookup(HashMap{ulong, Count}* table, c3f::Rule* r, char level)
{
	c3f::GapKey key = r.key();
	for (char l = level; l >= 2; l--)
	{
		Count* c = table.get_ref(key.pack(l)) ?? null;
		if (c && c.kept) return &c.rule;
	}
	return null;
}

fn int main(String[] args)
{
	HashMap{ulong, Count} table;
	table.init(mem);
	foreach (path : args[1..])
	{
		@pool()
		{
			String text = (String)file::load_temp(path)!!;
			c3f::Src s;
			s.init(text);
			for (sz i = 1; i < s.len(); i++)
			{
				if (s.toks[i].nl != 0 || s.toks[i].keep) continue;
				String gap = s.gap(i);
				if (gap.len > 1 || (gap.len == 1 && gap[0] != ' ')) continue;   // alignment
				c3f::GapKey k = s.gap_key(i);
				for (char level = 2; level <= 4; level++) count(&table, &k, level, gap.len == 1);
			}
		};
	}
	// keep a cell only where it says something its coarser cell does not
	for (char level = 2; level <= 4; level++)
	{
		table.@each_entry(; entry)
		{
			Count* c = &entry.value;
			if (c.rule.level == level && c.rule.n0 + c.rule.n1 >= MIN_COUNT && !c.rule.weak())
			{
				c3f::Rule* parent = level == 2 ? null : lookup(&table, &c.rule, level - 1);
				c.kept = level == 2 || decision(&c.rule) != decision(parent);
			}
		};
	}
	List{c3f::Rule} rules;
	rules.init(mem);
	table.@each(; ulong key, Count c)
	{
		if (c.kept) rules.push(c.rule);
	};
	sort::quicksort(&rules, fn int(c3f::Rule a, c3f::Rule b) => a.pack() < b.pack() ? -1 : a.pack() > b.pack() ? 1 : 0);
	io::printn("// Generated by tools/gen_spacing.c3 from the C3 standard library. Do not edit by hand.");
	io::printn("// Each cell: how often the corpus wrote no space / one space in this context (c3f::Rule).");
	io::printn("module c3f;");
	io::printn("import c3::lexer;");
	io::printn("");
	io::printn("const Rule[] SPACING_RULES = {");
	foreach (r : rules)
	{
		io::printfn("\t{%d, %s, %s, %s, %s, %s, %d, %d},", r.level, r.p2, r.p1, r.nx, r.co, r.cb, r.n0, r.n1);
	}
	io::printn("};");
	return 0;
}
