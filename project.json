{
  "langrev": "1",
  "authors": [
    "Koni Marti <koni.marti@gmail.com>"
  ],
  "version": "0.2.0",
  "warnings": [
    "no-unused"
  ],
  "dependency-search-paths": [
    "lib"
  ],
  "dependencies": [
    "lexer"
  ],
  "sources": [
    "src/c3f/**"
  ],
  "test-sources": [
    "test/**",
    "src/cli/**"
  ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "c3f": {
      "type": "executable",
      "sources": [
        "src/cli/**"
      ]
    },
    "gen-spacing": {
      "type": "executable",
      "sources": [
        "tools/gen_spacing.c3"
      ],
      "opt": "O1"
    }
  },
  "opt": "O3"
}
